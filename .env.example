# Resend API key used by src/app/api/contact/route.ts to send mail. Get one
# at https://resend.com/api-keys. Without it, the contact route returns a
# 500 and the UI falls back to a mailto link — the form still "works," it
# just doesn't send.
RESEND_API_KEY=

# Inbox that receives contact-form messages. Defaults to profile.email
# (content/profile.ts) if unset.
CONTACT_TO_EMAIL=

# Sender address Resend sends from. Defaults to onboarding@resend.dev
# (Resend's shared test sender) if unset — swap in a verified-domain address
# once one exists.
CONTACT_FROM_EMAIL=

# Deployed origin, used for canonical URLs, OG/Twitter cards, sitemap, robots,
# and JSON-LD (e.g. https://malharkansara.com). Without it, absolute URLs fall
# back to the Vercel per-deploy URL, then http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=
